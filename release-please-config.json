{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "pull-request-title-pattern": "chore(release): release${component} ${version}",
  "packages": {
    ".": {
      "release-type": "simple",
      "draft": true,
      "component": "maya-plugin",
      "include-component-in-tag": true,
      "include-v-in-tag": true,
      "tag-separator": "-",
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": false,
      "changelog-path": "CHANGELOG.md",
      "changelog-sections": [
        { "type": "feat", "section": "Features" },
        { "type": "fix", "section": "Bug Fixes" },
        { "type": "perf", "section": "Performance Improvements" },
        { "type": "revert", "section": "Reverts" },
        { "type": "docs", "section": "Documentation" },
        { "type": "chore", "section": "Miscellaneous Chores" },
        { "type": "ci", "section": "Continuous Integration" },
        { "type": "test", "section": "Tests" },
        { "type": "refactor", "section": "Code Refactoring" },
        { "type": "build", "section": "Build System" },
        { "type": "style", "section": "Styles" }
      ],
      "extra-files": [
        { "type": "toml", "path": "pyproject.toml", "jsonpath": "$.project.version" },
        { "type": "generic", "path": "ScenarioForMaya/scripts/scenario_maya/__init__.py" },
        { "type": "generic", "path": "ScenarioForMaya.mod" }
      ]
    }
  }
}
